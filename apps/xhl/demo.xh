var n = 0;
var a = 0;
var b = 1;
func fib() {
  var i = 0;
  var t = 0;
  while (i < n) { t = a + b; a = b; b = t; i = i + 1; }
}
n = 10;
fib();
printf("fib(%d) = %d\n", n, a);
var k = 1;
while (k <= 15) {
  if (k % 15 == 0) { printf("FizzBuzz\n"); }
  else if (k % 3 == 0) { printf("Fizz\n"); }
  else if (k % 5 == 0) { printf("Buzz\n"); }
  else { printf("%d\n", k); }
  k = k + 1;
}
var x = 7;
if (x > 3 && x < 10 || 0) { printf("%s\n", "in range"); }
if (!(x == 7)) { printf("bad\n"); } else { printf("%d%%\n", -x * 2 + 1); }
printf("%c%c\n", 'A', 66);
